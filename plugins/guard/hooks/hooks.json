{
  "description": "Guard: stop a commit that adds a likely secret, and stop commits made directly on main or master.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-secret-commit.sh"], "timeout": 30 },
          { "type": "command", "command": "bash", "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/block-main-commit.sh"], "timeout": 10 }
        ]
      }
    ]
  }
}
